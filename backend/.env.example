# ============================================================
# 项目根 .env 模板（拷贝为 .env 后填实际值）
# ============================================================

# ---- shared/ 基础配置（PORT / LOG_LEVEL / ENV / JWT_SECRET） ----
PORT=8000
LOG_LEVEL=INFO
ENV=dev
JWT_SECRET=change-me-in-prod

# ---- 各区自有数据库（各负责人管自己的，**不要共享**） ----
# 格式：mysql+aiomysql://user:password@host:port/dbname
# 成员 A
USER_CHAT_DB_URL=mysql+aiomysql://root:你的root密码@localhost:3306/tzb_user_chat
# 成员 B
STUDENT_DATA_DB_URL=mysql+aiomysql://root:你的root密码@localhost:3306/tzb_student_data
# 成员 C
LEARNING_CONTENT_DB_URL=mysql+aiomysql://root:你的root密码@localhost:3306/tzb_learning_content
# 成员 D
AI_INTEGRATION_DB_URL=mysql+aiomysql://root:你的root密码@localhost:3306/tzb_ai_integration

# ---- 成员 D：3 个 AI 服务配置（之后接 3 个 AI 时填） ----
# AI 1：辅导对话
CHAT_AI_ENDPOINT=https://api.example.com/v1/chat
CHAT_AI_API_KEY=sk-xxx
CHAT_AI_MODEL=gpt-4

# AI 2：学习路径生成
PATH_AI_ENDPOINT=https://api.example.com/v1/path
PATH_AI_API_KEY=sk-xxx
PATH_AI_MODEL=gpt-4

# AI 3：学习建议生成
SUGGEST_AI_ENDPOINT=https://api.example.com/v1/suggest
SUGGEST_AI_API_KEY=sk-xxx
SUGGEST_AI_MODEL=gpt-4
